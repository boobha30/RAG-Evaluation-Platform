OPENAI_API_KEY=sk-...
GENERATION_MODEL=gpt-4o-mini
JUDGE_MODEL=gpt-4o-mini
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Free alternative: run generation + judging against a local Ollama server
# instead of OpenAI (no key/billing needed). Install with `brew install
# ollama`, `ollama pull llama3.2:3b`, then uncomment below and leave
# OPENAI_API_KEY unset (or comment it out):
# OPENAI_BASE_URL=http://localhost:11434/v1
# GENERATION_MODEL=llama3.2:3b
# JUDGE_MODEL=llama3.2:3b

# Hybrid retrieval + reranking
USE_HYBRID=true
USE_RERANKER=true

# Eval logging. Defaults to a local sqlite file so the app works with zero
# setup; point this at Postgres for the full dashboard experience, e.g.
# postgresql+psycopg2://rag:rag@localhost:5432/rag_eval
DATABASE_URL=sqlite:///./data/eval/eval.db
EVALUATE_LIVE_QUERIES=true
